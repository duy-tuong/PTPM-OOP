# Copy file này thành .env (cùng cấp docker-compose.yml) rồi điền giá trị thật trước khi chạy
# `docker compose up --build`. KHÔNG commit file .env thật (đã có trong .gitignore). Khi deploy qua
# CI/CD, file .env trên VM được workflow (.github/workflows/main.yml) tự sinh từ GitHub Secrets cùng
# tên - không cần tạo tay trên VM.

# Mật khẩu tài khoản sa của SQL Server container - tối thiểu 8 ký tự, có chữ hoa/thường/số/ký tự đặc biệt.
DB_SA_PASSWORD=

# Khoá ký JWT - dán 1 chuỗi ngẫu nhiên đủ dài (vd: openssl rand -base64 64).
JWT_SECRET_KEY=

# PayOS - lấy tại dashboard PayOS > Kênh thanh toán > Hướng dẫn tích hợp trên website.
App__PayOsClientId=
App__PayOsApiKey=
App__PayOsChecksumKey=

# Resend - lấy tại resend.com > API Keys.
App__ResendApiKey=
# Địa chỉ gửi - mặc định "onboarding@resend.dev" (chỉ gửi được tới email tài khoản Resend/địa chỉ test
# delivered@resend.dev) cho tới khi xác thực domain thật trong dashboard Resend.
App__EmailFromAddress=onboarding@resend.dev
App__EmailFromName=Cloudverse
